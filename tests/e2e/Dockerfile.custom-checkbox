# E2E test: custom checkbox markers + custom marker prefix
FROM alpine:edge

RUN apk add --no-cache neovim ripgrep git

# Copy plugin source
COPY lua/ /plugin/lua/
COPY plugin/ /plugin/plugin/
COPY syntax/ /plugin/syntax/
COPY ftdetect/ /plugin/ftdetect/
COPY doc/ /plugin/doc/
COPY tests/e2e/ /plugin/tests/e2e/

# Clone plenary.nvim
RUN git clone --depth 1 https://github.com/nvim-lua/plenary.nvim /deps/plenary.nvim

# Sample notes (only this config's file)
RUN mkdir -p /root/Documents/Notes
COPY tests/e2e/sample_notes/custom_checkbox.md /root/Documents/Notes/

# State directory
RUN mkdir -p /root/.local/state/task

ENTRYPOINT ["nvim", "--headless", "-u", "/plugin/tests/e2e/custom_checkbox_test.lua"]
